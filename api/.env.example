STORYTOOL_DEBUG=true
STORYTOOL_DB_ECHO=false
STORYTOOL_DATABASE_URL=postgresql+asyncpg://storytool:storytool@localhost:5432/storytool

# --- Noticing (Phase 4) ---------------------------------------------------
# auto | deterministic | claude | jev
# "auto" prefers Jev, then Claude, then deterministic. With no key set the
# deterministic noticer is used and the feature degrades rather than erroring.
STORYTOOL_NOTICING_BACKEND=auto

# Jev / TypeSafe System One. Returns typed values and probabilities, never text.
TYPESAFE_API_KEY=
STORYTOOL_JEV_MODEL=jev-latest

# Claude. Used when no Jev key is present.
ANTHROPIC_API_KEY=
STORYTOOL_NOTICING_MODEL=claude-sonnet-5-5
