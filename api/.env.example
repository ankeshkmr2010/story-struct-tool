STORYTOOL_DEBUG=true
STORYTOOL_DB_ECHO=false
STORYTOOL_DATABASE_URL=postgresql+asyncpg://storytool:storytool@localhost:5432/storytool

# Google Identity Services Web client ID. Add http://localhost:5173 and your
# ngrok HTTPS origin to its Authorized JavaScript origins in Google Cloud.
STORYTOOL_GOOGLE_CLIENT_ID=
# Only this verified Google account may claim stories created before accounts existed.
STORYTOOL_LEGACY_OWNER_EMAIL=

# --- Noticing (Phase 4) ---------------------------------------------------
# auto | deterministic | claude | jev
# "auto" prefers Jev, then Claude, then deterministic. With no key set the
# deterministic noticer is used and the feature degrades rather than erroring.
STORYTOOL_NOTICING_BACKEND=auto

# Jev / TypeSafe System One. Shared Noticing for every user when configured.
# The server-only key takes priority over personal reader connections; authoring is unchanged.
TYPESAFE_API_KEY=
STORYTOOL_JEV_MODEL=jev-latest

# Claude. Used when no Jev key is present.
ANTHROPIC_API_KEY=
STORYTOOL_NOTICING_MODEL=claude-sonnet-5-5
STORYTOOL_AI_ENCRYPTION_KEY=

# Optional production React build directory. Leave unset when using Vite locally.
STORYTOOL_FRONTEND_DIR=

# Cloudflare embeddings. Enable after supplying a Workers AI API token.
STORYTOOL_SEMANTIC_SEARCH_ENABLED=false
STORYTOOL_SEARCH_EMBEDDING_URL=https://api.cloudflare.com/client/v4/accounts/<account-id>/ai/v1/embeddings
STORYTOOL_SEARCH_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
STORYTOOL_SEARCH_EMBEDDING_DIMENSIONS=384
STORYTOOL_SEARCH_EMBEDDING_API_KEY=
STORYTOOL_SEARCH_EMBEDDING_MAX_INPUT_BYTES=480
STORYTOOL_SEARCH_EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
